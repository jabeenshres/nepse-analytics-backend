[Unit]
Description=NEPSE Web (Next.js)
After=network.target

[Service]
Type=simple
User=nepse
Group=nepse
WorkingDirectory=/srv/nepse/Stock_FE
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

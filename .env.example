# Template for the production backend. Copy to .env on the server and fill in.
# Never commit the real .env.

# --- Django core ---
DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=api.nepse.raijintech.com
# Use a non-obvious path, keep the trailing slash.
DJANGO_ADMIN_URL=admin/

# --- Frontend origin allowed to call the API from the browser ---
CORS_ALLOWED_ORIGINS=https://nepse.raijintech.com
CSRF_TRUSTED_ORIGINS=https://api.nepse.raijintech.com

# --- HTTPS behind Nginx ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# --- Database: sqlite3 or postgresql ---
DB_ENGINE=postgresql
DB_NAME=nepse
DB_USER=nepse
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Tokens ---
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# --- Misc ---
TIME_ZONE=Asia/Kathmandu
LOG_LEVEL=INFO

# --- Cache (file-based; /var/cache/nepse in prod) ---
CACHE_DIR=/srv/nepse/stock_BE/var/cache
CACHE_TIMEOUT=300
CACHE_MAX_ENTRIES=2000
